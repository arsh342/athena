{
  "name": "@arsh342/athena",
  "version": "0.5.1",
  "description": "AI code provenance tracker and terminal scanner for JavaScript/TypeScript, Python, Java, C#, C/C++, Go, Rust, PHP and Shell repositories.",
  "type": "module",
  "bin": {
    "athena": "dist/index.cjs"
  },
  "main": "dist/index.cjs",
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/index.ts",
    "prepack": "npm run build",
    "pack:dry": "npm pack --dry-run",
    "test": "node --import tsx --test test/**/*.test.ts"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "null-pointer-font"
  ],
  "keywords": [
    "ai",
    "code-review",
    "security",
    "static-analysis",
    "cli",
    "typescript",
    "provenance"
  ],
  "author": "Arshdeep Singh",
  "license": "MIT",
  "homepage": "https://github.com/arsh342/athena#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arsh342/athena.git"
  },
  "bugs": {
    "url": "https://github.com/arsh342/athena/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "optionalDependencies": {
    "eslint": "^10.15.0",
    "eslint-plugin-security": "^4.2.1"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.11.0",
    "@athena/agents": "file:../agents",
    "@athena/core": "file:../core",
    "commander": "^14.0.0",
    "openai": "^7.62.0",
    "tsx": "^4.19.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@vscode/tree-sitter-wasm": "0.3.1",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "@google/genai": "^3.6.1"
  },
  "peerDependenciesMeta": {
    "@google/genai": {
      "optional": true
    }
  }
}
