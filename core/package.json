{
  "name": "@athena/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "models",
    "skills"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"require('fs').cpSync('src/deps/data','dist/deps/data',{recursive:true})\"",
    "dev": "tsx src/index.ts",
    "calibrate": "tsx src/calibration/calibrate-threshold.ts",
    "test": "node --import tsx --test test/**/*.test.ts"
  },
  "dependencies": {
    "@vscode/tree-sitter-wasm": "0.3.1",
    "smol-toml": "^1.9.1",
    "typescript": "^5.8.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "tsx": "^4.19.0",
    "vitest": "^2.1.8"
  },
  "optionalDependencies": {
    "eslint": "^9.0.0",
    "eslint-plugin-security": "^3.0.0"
  }
}
