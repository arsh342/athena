# Copy to .env and replace with real values
PORT=8787
DATABASE_URL=postgres://<db_user>:<db_password>@localhost:5432/athena
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
APP_ORIGIN=http://localhost:5173
API_ORIGIN=http://localhost:8787
AUTH_PROVIDER=legacy
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_SECURE=false

# --- Memory (a small instance, for example 512MB) ---
# Scans running at once. Default 1; see the note in src/scanner.ts before raising it.
# MAX_CONCURRENT_SCANS=1
# Set to off to turn the new-vulnerability alerts job off (it checks saved dependency lists against OSV once a day).
# ALERTS_JOB=on
# Cap Node's heap a little under the instance's memory so a spike fails loudly in the app instead of the instance being killed.
# On Render: set the environment variable NODE_OPTIONS=--max-old-space-size=384 for a 512MB instance.

# Scans run in a short-lived child process, because a scan's WebAssembly/native memory is not given back by a long-lived Node process.
# A scan needs roughly 250 MB + 1.1 MB per source file at its peak (ESLint, parsing and dependency checks together).
# SCAN_MEMORY_MB   memory budget for one web scan (default 500, about 227 files). Larger repositories are told to use the CLI. Raise it on a bigger instance (e.g. 1500 on 2 GB).
# SCAN_MAX_FILES   explicit file limit; overrides SCAN_MEMORY_MB
# SCAN_HEAP_MB     heap limit of the scan process (default 512)
# DEPS_CONCURRENCY parallel registry lookups during a scan (default 2)
